{
    "configurations": [
        {
            "name": "Embedded Framework (STM32H5 + RT-Thread)",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/include",
                "${workspaceFolder}/framework/config",
                "${workspaceFolder}/framework/include",
                "${workspaceFolder}/hal/include",
                "${workspaceFolder}/hal/stm32h5",
                "${workspaceFolder}/hal/common",
                "${workspaceFolder}/framework/ports/rtthread",
                "${workspaceFolder}/framework/ports/generic",
                "${workspaceFolder}/framework/startup/platforms/stm32h5",
                "${workspaceFolder}/third_party/stm32h5xx_hal_driver/Inc",
                "${workspaceFolder}/third_party/CMSIS/Core/Include",
                "${workspaceFolder}/third_party/CMSIS/Device/ST/STM32H5xx/Include",
                "${workspaceFolder}/third_party/CMSIS/Include",
                "${workspaceFolder}/third_party/CMSIS/DSP/Include",
                "${workspaceFolder}/third_party/CMSIS/NN/Include",
                "${workspaceFolder}/third_party/rt-thread/include",
                "${workspaceFolder}/third_party/FreeRTOS/include",
                "${workspaceFolder}/osal/common",
                "${workspaceFolder}/osal/rtthread",
                "${workspaceFolder}/osal/freertos",
                "${workspaceFolder}/app",
                "${workspaceFolder}/config"
            ],
            "defines": [
                "USE_HAL_DRIVER",
                "STM32H563xx",
                "HAL_PLATFORM_STM32H5=1",
                "RT_THREAD",
                "OSAL_RTOS_RTTHREAD=1",
                "__GNUC__",
                "__ARM_ARCH_8M__",
                "__ARM_FEATURE_DSP=1",
                "__CORTEX_M",
                "__CORTEX_M33",
                "CORE_CM33"
            ],
            "compilerPath": "/usr/local/arm/arm-gnu-toolchain-14.3.rel1-darwin-arm64-arm-none-eabi/bin/arm-none-eabi-gcc",
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "gcc-arm",
            "compilerArgs": [
                "-mcpu=cortex-m33",
                "-mthumb",
                "-mfpu=fpv5-sp-d16",
                "-mfloat-abi=hard",
                "-Og",
                "-g",
                "-gdwarf-2",
                "-Wall",
                "-Wextra",
                "-Wpointer-arith",
                "-Wstrict-prototypes",
                "-Wmissing-prototypes",
                "-Wmissing-declarations",
                "-Wunused",
                "-Wuninitialized",
                "-Werror=return-type",
                "-ffunction-sections",
                "-fdata-sections",
                "-std=c11",
                "-fmessage-length=0",
                "-MMD",
                "-MP",
                "-specs=nano.specs",
                "-specs=nosys.specs"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/**"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db"
            },
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "version": 4
}