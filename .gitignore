# 编译生成的目标文件、库文件和可执行文件
*.o
*.a
*.so
*.d
*.elf
*.hex
*.bin
*.map
*.lst
*.sym

# 构建输出目录（整个 build/ 目录）
build/

# 编辑器备份和临时文件
*~
.*.swp
.*.swo
.*.swn
.*.bak
.*.orig

# macOS 系统文件
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# IDE 项目文件（如 VSCode、CLion、Eclipse 等）
.vscode/
.idea/
*.user
*.workspace
*.project
*.cproject

# 标签文件（ctags 等生成的索引）
tags
cscope.*