# ==========================================================================
# Building
# ==========================================================================

# obj is the directory relative to srctree
# objtree is the output directory root

# Include global configuration
include $(srctree)/config.mk

# Include global Makefile.lib for c_flags
include $(srctree)/scripts/Makefile.lib

# Source directory for this component
src := $(srctree)/$(obj)

# Include the component's Makefile (or Kbuild)
kbuild-dir := $(src)
kbuild-file := $(if $(wildcard $(kbuild-dir)/Kbuild),$(kbuild-dir)/Kbuild,$(kbuild-dir)/Makefile)
include $(kbuild-file)

# Output directory for this component
obj-dir := $(objtree)/$(obj)

# ==========================================================================
# Process object list: separate directories and files
# ==========================================================================

# Directories end with '/' in obj-y
__subdir-y	:= $(patsubst %/,%,$(filter %/, $(obj-y)))
subdir-y	:= $(sort $(__subdir-y))
obj-y		:= $(filter-out %/, $(obj-y))

# Built-in.o files for subdirectories
subdir-builtin := $(addprefix $(obj-dir)/,$(addsuffix /built-in.o,$(subdir-y)))

# ==========================================================================
# Build rules
# ==========================================================================

# Default target
__build: $(obj-dir)/built-in.o

# Compile C sources
$(obj-dir)/%.o: $(src)/%.c
	@echo "  CC      $@"
	@mkdir -p $(dir $@)
	$(CC) $(c_flags) -c -o $@ $<

# Compile assembly sources (lowercase .s)
$(obj-dir)/%.o: $(src)/%.s
	@echo "  AS      $@"
	@mkdir -p $(dir $@)
	$(CC) -x assembler-with-cpp $(c_flags) -c -o $@ $<

# Compile preprocessed assembly sources (uppercase .S)
$(obj-dir)/%.o: $(src)/%.S
	@echo "  AS      $@"
	@mkdir -p $(dir $@)
	$(CC) -x assembler-with-cpp $(c_flags) -c -o $@ $<

# Convert obj-y list to absolute object paths
obj-y := $(addprefix $(obj-dir)/,$(obj-y))

# Link built-in.o (including subdirectory built-in.o files)
$(obj-dir)/built-in.o: $(obj-y) $(subdir-builtin)
	@echo "  LD      $@"
	@mkdir -p $(dir $@)
	$(LD) -r -o $@ $(filter %.o,$^)

# Rule to build subdirectory built-in.o files
$(obj-dir)/%/built-in.o: FORCE
	$(Q)$(MAKE) $(build)=$(obj)/$* obj=$(obj)/$*

# ==========================================================================
# Dependency files
# ==========================================================================

# Include dependency files (.d) generated by gcc -MMD
dep_files := $(foreach f,$(obj-y),$(f:.o=.d))
dep_files := $(filter-out $(obj-dir)/built-in.d,$(dep_files))
-include $(dep_files)

# ==========================================================================
# Phony targets
# ==========================================================================

.PHONY: __build FORCE
FORCE:

